#!/usr/bin/env bash
# Plastic Beach Knowledge Base MCP CLI
# Provides Bun-based access to search-related MCP tools

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MCP_BRIDGE="$PROJECT_ROOT/mcp-bridge"

# Check if kb-api is running
check_api() {
  if ! curl -s http://127.0.0.1:7777/v1/health > /dev/null 2>&1; then
    echo "⚠️  kb-api server is not running" >&2
    echo "   Start it with: kb-api" >&2
    return 1
  fi
  return 0
}

# Check if bun is installed
check_bun() {
  if ! command -v bun &> /dev/null; then
    echo "❌ Error: bun is not installed" >&2
    echo "   Install it from: https://bun.sh" >&2
    return 1
  fi
  return 0
}

case "$1" in
  search)
    check_api || exit 1
    check_bun || exit 1
    shift
    cd "$MCP_BRIDGE"
    bun run kb-cli.ts search "$@"
    ;;

  repos)
    check_api || exit 1
    check_bun || exit 1
    cd "$MCP_BRIDGE"
    bun run kb-cli.ts repos
    ;;

  chunk)
    check_api || exit 1
    check_bun || exit 1
    shift
    cd "$MCP_BRIDGE"
    bun run kb-cli.ts chunk "$@"
    ;;

  lines)
    check_api || exit 1
    check_bun || exit 1
    shift
    cd "$MCP_BRIDGE"
    bun run kb-cli.ts lines "$@"
    ;;

  info)
    check_api || exit 1
    check_bun || exit 1
    cd "$MCP_BRIDGE"
    bun run kb-cli.ts info
    ;;

  # Direct curl-based commands (no bun required)
  curl-search)
    check_api || exit 1
    shift
    query="$*"
    if [ -z "$query" ]; then
      echo "Usage: kb-search curl-search <query>" >&2
      exit 1
    fi
    curl -s -X POST http://127.0.0.1:7777/v1/search \
      -H "Content-Type: application/json" \
      -d "{\"query\": \"$query\", \"top_k\": ${KB_TOP_K:-5}}" | jq .
    ;;

  curl-repos)
    check_api || exit 1
    curl -s http://127.0.0.1:7777/v1/repos | jq .
    ;;

  curl-chunk)
    check_api || exit 1
    if [ -z "$2" ]; then
      echo "Usage: kb-search curl-chunk <chunk-id>" >&2
      exit 1
    fi
    curl -s "http://127.0.0.1:7777/v1/chunks/$2" | jq .
    ;;

  curl-file)
    check_api || exit 1
    if [ "$#" -lt 5 ]; then
      echo "Usage: kb-search curl-file <repo> <path> <start> <end>" >&2
      exit 1
    fi
    repo="$2"
    path="$3"
    start="$4"
    end="$5"
    curl -s "http://127.0.0.1:7777/v1/file?repo=$repo&path=$path&start=$start&end=$end" | jq .
    ;;

  health)
    if curl -s http://127.0.0.1:7777/v1/health > /dev/null 2>&1; then
      echo "✅ kb-api server is running"
      curl -s http://127.0.0.1:7777/v1/health | jq .
    else
      echo "❌ kb-api server is not running"
      exit 1
    fi
    ;;

  help|--help|-h|"")
    cat <<'EOF'
Plastic Beach Knowledge Base MCP CLI

Usage: kb-search <command> [options]

High-level commands (requires bun):
  search <query>                 Search the knowledge base
  repos                          List indexed repositories
  chunk <chunk-id>               Fetch a chunk by ID
  lines <repo> <path> <start> <end>
                                 Fetch file lines
  info                           Show vector store info

Direct REST API commands (curl-based, no bun required):
  curl-search <query>            Search via curl (outputs JSON)
  curl-repos                     List repos via curl (outputs JSON)
  curl-chunk <chunk-id>          Fetch chunk via curl (outputs JSON)
  curl-file <repo> <path> <start> <end>
                                 Fetch file via curl (outputs JSON)
  health                         Check if kb-api is running

Environment Variables:
  KB_TOP_K=N                     Number of search results (default: 5)
  KB_REPOS=repo1,repo2           Filter search to specific repos

Examples:
  kb-search search "authentication function"
  KB_TOP_K=10 kb-search search "error handling"
  KB_REPOS=api-server kb-search search "login"
  kb-search repos
  kb-search chunk abc123def456
  kb-search lines my-repo src/main.py 1 50

Notes:
  - Use 'curl-*' commands if you don't have bun installed
  - The 'curl-*' commands output raw JSON that you can pipe to jq
  - High-level commands rely on bun and the MCP bridge tooling
EOF
    ;;

  *)
    echo "Error: Unknown command '$1'" >&2
    echo "Run 'kb-search help' for usage information" >&2
    exit 1
    ;;
esac
