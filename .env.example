# Dolphin environment variables — copy to .env and fill in values.
# Dolphin reads from the environment; this file is NOT auto-loaded.
# Use `set -a && source .env && set +a` or your shell / process manager.

# ── Required ───────────────────────────────────────────────────────────────────
# OpenAI API key — required for embedding operations (indexing and search).
OPENAI_API_KEY=sk-your-key-here

# ── Authentication ─────────────────────────────────────────────────────────────
# Override the auto-generated KB API key (stored at ~/.dolphin/kb_api_key).
# If not set, Dolphin generates and manages the key automatically.
# DOLPHIN_API_KEY=

# ── Configuration ──────────────────────────────────────────────────────────────
# Override the path to the user-level config file (default: ~/.dolphin/config.toml).
# DOLPHIN_CONFIG_PATH=

# ── Logging ────────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# DOLPHIN_LOG_LEVEL=INFO
# Include Python tracebacks in structured log output: 1 | 0 (default: 0)
# DOLPHIN_LOG_TRACEBACK=0

# ── File-watcher timeouts (seconds) ───────────────────────────────────────────
# How long to wait for in-flight watch tasks to finish on server shutdown.
# DOLPHIN_WATCH_SHUTDOWN_TIMEOUT=15
# How long to wait for cancellation of watch tasks on server shutdown.
# DOLPHIN_WATCH_CANCEL_TIMEOUT=5

# ── BM25 / hybrid search tuning ───────────────────────────────────────────────
# Override the path to pre-computed BM25 statistics (default: auto-discovered).
# DOLPHIN_BM25_STATS_PATH=
# Force a specific BM25 score normalizer: sigmoid | quantile | minmax
# DOLPHIN_FORCE_BM25_NORMALIZER=

# ── Observability stack (docker-compose) ──────────────────────────────────────
# Required when running observability/docker-compose.yml (no defaults).
# GRAFANA_ADMIN_USER=
# GRAFANA_ADMIN_PASSWORD=
