{
  "mcpServers": {
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount", "type=bind,src=/Users/tdc/Desktop,dst=/files/Desktop",
        "--mount", "type=bind,src=/Users/tdc/worktable,dst=/files/worktable",
        "mcp/filesystem",
        "/files"
      ]
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=America/Los_Angeles"]
    },
    "notionMCP": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/sse"]
    }
  }
}
