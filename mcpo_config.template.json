{
  "mcpServers": {
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=__HOME__/worktable,dst=/worktable",
        "mcp/filesystem",
        "/worktable"
      ]
    },
    "memory": {
      "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=America/New_York"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "__HOME__/worktable/dolphin"
      ]
    }
  }
}
