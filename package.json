{
  "name": "pb-dolphin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mcp-bridge",
    "shared"
  ],
  "scripts": {
    "setup": "bun install && cd mcp-bridge && bun install && cd .. && cd shared && bun install",
    "build:all": "cd mcp-bridge && bun run build",
    "lint:all": "cd mcp-bridge && bun run lint",
    "test:mcp": "cd mcp-bridge && bun run test:clean",
    "test:unit": "bun run test:mcp",
    "clean": "rm -rf mcp-bridge/dist shared/dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,svelte}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
