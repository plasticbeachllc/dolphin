{
  "name": "pb-dolphin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mcp-bridge",
    "shared"
  ],
  "scripts": {
    "setup": "bun install",
    "build:all": "cd mcp-bridge && bun run build",
    "lint:all": "cd mcp-bridge && bun run lint",
    "test:mcp": "cd mcp-bridge && bun run test:clean",
    "test:unit": "bun run test:mcp",
    "guard:quick": "uv run ruff check && uv run ruff format --check && bun run lint:all && uv run pytest tests/unit/api/test_api_endpoints.py -q --maxfail=1 && cd mcp-bridge && bun test --serial ./src/tests/unit --bail && cd ../shared && bun test __tests__/kb-auth.test.ts ipc/__tests__/serialization.test.ts --bail",
    "clean": "rm -rf mcp-bridge/dist shared/dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,svelte}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk>body-parser": "2.2.2",
    "@modelcontextprotocol/sdk>express>qs": "6.15.0",
    "@modelcontextprotocol/sdk>hono": "^4.12.5",
    "@modelcontextprotocol/sdk>qs": "6.15.0",
    "@hono/node-server": "^1.19.11",
    "express-rate-limit": "^8.3.0",
    "hono": "^4.12.5",
    "qs": "^6.15.0",
    "minimatch": ">=10.2.3"
  }
}
