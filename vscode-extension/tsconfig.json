{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["mocha", "node", "vscode"],
    "resolveJsonModule": true
  },
  "include": ["src", "../shared"],
  "exclude": [
    "node_modules",
    "webview",
    ".vscode-test",
    "../shared/__tests__",
    "../shared/tests",
    "../shared/**/*.test.ts"
  ]
}
