{
    "name": "dolphin",
    "displayName": "Dolphin AI",
    "description": "AI coding assistant with semantic code search",
    "version": "0.1.0",
    "publisher": "pb",
    "icon": "resources/extension-icon.png",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "dolphin",
                    "title": "Dolphin",
                    "icon": "resources/dolphin-activity-bar.svg"
                }
            ]
        },
        "views": {
            "dolphin": [
                {
                    "type": "webview",
                    "id": "dolphin.chatView",
                    "name": "Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "dolphin.focusInput",
                "title": "Dolphin: Focus Input"
            },
            {
                "command": "dolphin.newConversation",
                "title": "Dolphin: New Conversation"
            },
            {
                "command": "dolphin.test",
                "title": "Dolphin: Test"
            },
            {
                "command": "dolphin.kb.showStatus",
                "title": "Dolphin: Show KB Status"
            },
            {
                "command": "dolphin.kb.restart",
                "title": "Dolphin: Restart Knowledge Base"
            }
        ],
        "configuration": {
            "title": "Dolphin Knowledge Base",
            "properties": {
                "dolphin.kb.debounceMs": {
                    "type": "number",
                    "default": 2000,
                    "description": "Milliseconds to wait after file change before indexing"
                },
                "dolphin.kb.batchIntervalMs": {
                    "type": "number",
                    "default": 5000,
                    "description": "Milliseconds between batch processing intervals"
                },
                "dolphin.kb.excludePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/.git/**",
                        "**/out/**",
                        "**/*.min.js"
                    ],
                    "description": "Patterns to exclude from automatic indexing"
                }
            }
        },
        "keybindings": [
            {
                "command": "dolphin.focusInput",
                "key": "cmd+l",
                "when": "dolphin.chatViewVisible"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.10.0",
        "@types/vscode": "^1.96.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.2.1",
        "glob": "^11.0.0",
        "mocha": "^10.8.2",
        "typescript": "^5.7.2"
    }
}