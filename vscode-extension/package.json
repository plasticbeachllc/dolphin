{
    "name": "dolphin",
    "displayName": "Dolphin AI",
    "description": "AI coding assistant with semantic code search",
    "version": "0.1.0",
    "publisher": "pb",
    "icon": "resources/dolphin_vscode.png",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onView:dolphin.chatView",
        "onCommand:dolphin.focusInput",
        "onCommand:dolphin.newConversation",
        "onCommand:dolphin.setApiKey",
        "onCommand:dolphin.test",
        "onCommand:dolphin.askAboutSelection",
        "onCommand:dolphin.refactorSelection",
        "onCommand:dolphin.askAboutFile",
        "onCommand:dolphin.askAboutFolder"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "dolphin",
                    "title": "Dolphin",
                    "icon": "resources/dolphin_vscode.png"
                }
            ]
        },
        "views": {
            "dolphin": [
                {
                    "type": "webview",
                    "id": "dolphin.chatView",
                    "name": "Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "dolphin.focusInput",
                "title": "Dolphin: Focus Input"
            },
            {
                "command": "dolphin.newConversation",
                "title": "Dolphin: New Conversation"
            },
            {
                "command": "dolphin.setApiKey",
                "title": "Dolphin: Set API Key"
            },
            {
                "command": "dolphin.test",
                "title": "Dolphin: Test"
            },
            {
                "command": "dolphin.kb.showStatus",
                "title": "Dolphin: Show KB Status"
            },
            {
                "command": "dolphin.kb.restart",
                "title": "Dolphin: Restart Knowledge Base"
            },
            {
                "command": "dolphin.askAboutSelection",
                "title": "Dolphin: Ask About Selection"
            },
            {
                "command": "dolphin.refactorSelection",
                "title": "Dolphin: Refactor Selection"
            },
            {
                "command": "dolphin.askAboutFile",
                "title": "Dolphin: Ask About This File"
            },
            {
                "command": "dolphin.askAboutFolder",
                "title": "Dolphin: Ask About This Folder"
            },
            {
                "command": "dolphin.applyDiff",
                "title": "Dolphin: Apply Diff"
            }
        ],
        "configuration": {
            "title": "Dolphin",
            "properties": {
                "dolphin.kb.debounceMs": {
                    "type": "number",
                    "default": 2000,
                    "description": "Milliseconds to wait after file change before indexing"
                },
                "dolphin.kb.batchIntervalMs": {
                    "type": "number",
                    "default": 5000,
                    "description": "Milliseconds between batch processing intervals"
                },
                "dolphin.kb.excludePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/.git/**",
                        "**/out/**",
                        "**/*.min.js"
                    ],
                    "description": "Patterns to exclude from automatic indexing"
                },
                "dolphin.model": {
                    "type": "string",
                    "default": "claude-sonnet-4-5-20250929",
                    "description": "Claude model to use for chat"
                },
                "dolphin.maxTokens": {
                    "type": "number",
                    "default": 8192,
                    "description": "Maximum tokens for responses"
                },
                "dolphin.temperature": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Temperature for response generation (0-1)"
                },
                "dolphin.useTools": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable tool use (file operations, search, etc.)"
                },
                "dolphin.enableTelemetry": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable anonymous usage telemetry"
                },
                "dolphin.logLevel": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "debug"
                    ],
                    "default": "info",
                    "description": "Logging verbosity level"
                }
            }
        },
        "menus": {
            "editor/context": [
                {
                    "command": "dolphin.askAboutSelection",
                    "when": "editorHasSelection",
                    "group": "dolphin@1"
                },
                {
                    "command": "dolphin.refactorSelection",
                    "when": "editorHasSelection",
                    "group": "dolphin@2"
                }
            ],
            "explorer/context": [
                {
                    "command": "dolphin.askAboutFile",
                    "when": "!explorerResourceIsFolder",
                    "group": "dolphin@1"
                },
                {
                    "command": "dolphin.askAboutFolder",
                    "when": "explorerResourceIsFolder",
                    "group": "dolphin@1"
                }
            ]
        },
        "keybindings": [
            {
                "command": "dolphin.focusInput",
                "key": "cmd+l",
                "when": "dolphin.chatViewVisible"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.10.0",
        "@types/vscode": "^1.96.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.2.1",
        "glob": "^11.0.0",
        "mocha": "^10.8.2",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "vscode-jsonrpc": "^8.2.1"
    }
}
