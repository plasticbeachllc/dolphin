{
  "name": "Dolphin-KB",
  "description": "Dolphin semantic code search",
  "server": {
    "command": "bunx",
    "args": ["dolphin-mcp"],
    "env": {
      "DOLPHIN_API_URL": "http://127.0.0.1:7777",
      "LOG_LEVEL": "info",
      "MAX_CONCURRENT_SNIPPET_FETCH": "8",
      "SNIPPET_FETCH_TIMEOUT_MS": "2000",
      "SNIPPET_FETCH_RETRY_ATTEMPTS": "1"
    }
  }
}
