{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests",
    "../shared/**/__tests__/**",
    "../shared/tests/**"
  ]
}
